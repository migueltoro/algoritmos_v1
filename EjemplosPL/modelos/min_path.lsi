head section

Integer getN()
Double edgeWeight(Integer i, Integer j)
Boolean containsEdge(Integer i, Integer j)
Integer n = getN()
Integer v0 = 0
Integer v1 = 6


goal section

min sum(edgeWeight(i,j) x[i,j], i in 0 .. n, j in 0 .. n |containsEdge(i,j))

constraints section

sum(x[v0,j], j in 0 .. n | containsEdge(v0,j)) = 1
sum(x[i,v1], i in 0 .. n | containsEdge(i,v1)) = 1
sum(x[j,i], j in 0 .. n | containsEdge(j,i))- sum(x[i,j], j in 0 .. n | containsEdge(i,j)) = 0,i in 1 .. n | i != v0 && i != v1
x[i,j] = 1 -> y[j] - y[i] = 1, i in 0 .. n, j in 0 .. n | containsEdge(i,j)
y[v0] = 0

bounds section

y[i] <= n - 1, i in 0 .. n

bin

x[i,j], i in 0 .. n, j in 0 .. n | containsEdge(i,j)

int

y[i], i in 0 .. n
