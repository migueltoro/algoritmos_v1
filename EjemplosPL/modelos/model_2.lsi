head section

Integer n = 5
Float eps = 1.

goal section

min  sum(z1[i,j], i in 0 .. n, j in 0 .. n | j > i)

constraints section

//allDifferent(x[i], i in 0 .. n)

z1[i,j] = ABS (x[i] - x[j]), i in 0 .. n, j in 0 .. n | j > i
z1[i,j]  >= eps, i in 0 .. n, j in 0 .. n | j > i

h[i,j] - x[i] + x[j] = i-j, i in 0 .. n, j in 0 .. n | j > i
z2[i,j] = ABS(h[i,j]), i in 0 .. n, j in 0 .. n | j > i
z2[i,j]  >= eps, i in 0 .. n, j in 0 .. n | j > i

bounds section

x[i] <= n-1, i in 0 .. n

int  

x[i], i in 0 .. n